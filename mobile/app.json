{
  "expo": {
    "name": "ItWorksOnMyResume",
    "slug": "itworksonmyresume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.itworksonmyresume.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find nearby skill matches.",
        "NSCameraUsageDescription": "Used to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "Used to select your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.itworksonmyresume.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We need your location to find nearby skill matches."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "itworksonmyresume",
    "extra": {
      "apiUrl": "http://localhost:5000",
      "ntfyUrl": "http://localhost:8090"
    }
  }
}
